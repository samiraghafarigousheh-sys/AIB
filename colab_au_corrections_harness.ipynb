    "\n",
    "if comparison_csv.exists():\n",
    "    df_states = pd.read_csv(comparison_csv)\n",
    "    print(\"\\n\" + \"=\"*80)\n",
    "    print(\"COMPARISON BY STATE (Heating, Cooling, Total in kWh/m²)\")\n",
    "    print(\"=\"*80)\n",
    "    print(df_states.to_string(index=False))\n    print()\n",
    "else:\n",
    "    print(f\"Comparison file not found: {comparison_csv}\")\n",
    "\n",
    "if comparison_by_metric_csv.exists():\n",
    "    df_metrics = pd.read_csv(comparison_by_metric_csv)\n",
    "    print(\"\\n\" + \"=\"*80)\n",
    "    print(\"COMPARISON BY METRIC (States as Columns)\")\n",
    "    print(\"=\"*80)\n",
    "    print(df_metrics.to_string(index=False))\n    print()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Display Grouped Bar Chart"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Look for the chart image\n",
    "chart_paths = list(Path(repo_path / \"results\" / \"au_corrections_summary\").glob(\"comparison_*.png\"))\n",
    "\n",
    "if chart_paths:\n",
    "    from IPython.display import Image, display\n",
    "    print(\"\\nGrouped Bar Chart: Heating, Cooling, and Total across all states\")\n",
    "    print(\"=\"*80)\n",
    "    display(Image(str(chart_paths[0])))\n",
    "else:\n",
    "    print(\"Chart not found. Generating it now...\")\n",
    "    # We can generate it programmatically if needed\n",
    "    if comparison_by_metric_csv.exists():\n",
    "        df_metrics = pd.read_csv(comparison_by_metric_csv)\n",
    "        # Extract metric and states\n",
    "        metrics = df_metrics[\"Metric\"].tolist()\n",
    "        state_cols = [c for c in df_metrics.columns if c != \"Metric\"]\n",
    "        \n",
    "        fig, ax = plt.subplots(figsize=(14, 6))\n",
    "        x = range(len(metrics))\n",
    "        width = 0.15\n",
    "        \n",
    "        for i, state in enumerate(state_cols):\n",
    "            values = pd.to_numeric(df_metrics[state], errors='coerce')\n",
    "            ax.bar([xi + width*i for xi in x], values, width, label=state)\n",
    "        \n",
    "        ax.set_xlabel(\"Metric\", fontsize=12)\n",
    "        ax.set_ylabel(\"Energy (kWh/m²)\", fontsize=12)\n",
    "        ax.set_title(\"Australian Building Energy Corrections: Cumulative Impact\", fontsize=14, fontweight='bold')\n",
    "        ax.set_xticks([xi + width*2 for xi in x])\n",
    "        ax.set_xticklabels(metrics, rotation=45, ha='right')\n",
    "        ax.legend(loc='upper right', fontsize=10)\n",
    "        ax.grid(axis='y', alpha=0.3)\n",
    "        plt.tight_layout()\n",
    "        plt.savefig(str(Path(repo_path) / \"results\" / \"au_corrections_summary\" / \"comparison_chart.png\"), dpi=150, bbox_inches='tight')\n",
    "        plt.show()\n",
    "        print(\"Chart generated.\")"
   ]
  },
