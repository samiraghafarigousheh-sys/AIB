! Envelope infiltration, matched to the corrected ISO engine.
! q50 = 14.0 m3/(h.m2)@50Pa over A_env = 13.50 m2
! n50 = 3.500000 1/h over V = 54.0 m3, LBL N = 20
! n_inf = 0.175000 1/h = 0.00262500 m3/s
! schedule: the ISO stack/wind modulation f(t), precomputed from the corrected ISO run
  ZoneInfiltration:DesignFlowRate,
    Apt305_Infiltration, Apt305, Inf_Mod,
    Flow/Zone, 0.00262500, , , ,
    1.0, 0.0, 0.0, 0.0;

  Output:Variable, *, Zone Ideal Loads Supply Air Sensible Heating Energy, Hourly;
  Output:Variable, *, Zone Ideal Loads Supply Air Sensible Cooling Energy, Hourly;
  Output:Variable, *, Zone Infiltration Sensible Heat Loss Energy, Hourly;
  Output:Variable, *, Zone Infiltration Sensible Heat Gain Energy, Hourly;
  Output:Variable, *, Zone Ventilation Sensible Heat Loss Energy, Hourly;
  Output:Variable, *, Zone Ventilation Sensible Heat Gain Energy, Hourly;
  Output:Variable, *, Surface Average Face Conduction Heat Transfer Energy, Hourly;
  Output:Variable, *, Surface Window Net Heat Transfer Energy, Hourly;
  Output:Variable, *, Zone Windows Total Transmitted Solar Radiation Energy, Hourly;
  Output:Variable, *, Zone Operative Temperature, Hourly;